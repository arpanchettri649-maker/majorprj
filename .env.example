# Email Configuration for Gmail SMTP
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

EMAIL_ADDRESS=your-email@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Notes:
# 1. Generate App Password from Google Account Security settings
# 2. EMAIL_ADDRESS: Your Gmail address
# 3. EMAIL_APP_PASSWORD: 16-character app password (not your regular password)
# 4. Do not share these credentials with anyone
